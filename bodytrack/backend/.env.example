# Copie este arquivo para ".env" e ajuste os valores.
# NUNCA commite o arquivo .env real.

ENV=development
DEBUG=true

# Banco de dados PostgreSQL
DATABASE_URL=postgresql+psycopg2://bodytrack:bodytrack@localhost:5432/bodytrack

# Segurança — gere uma chave forte, por exemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=troque-esta-chave-por-uma-chave-secreta-forte
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# CORS — origens do frontend, separadas por vírgula (ajuste o parser se
# usar mais de uma)
CORS_ORIGINS=["http://localhost:5173"]

# Armazenamento de fotos
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=storage/photos
MAX_PHOTO_SIZE_MB=15
