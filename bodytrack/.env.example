# Variáveis usadas pelo docker-compose.prod.yml (deploy via Docker
# Compose num VPS). Copie para ".env" na raiz do projeto e ajuste os
# valores — esse arquivo raiz NUNCA deve ser commitado.
#
# Isso é diferente de backend/.env.example e frontend/.env.example,
# que configuram cada serviço quando rodado fora do Docker (Etapa 5,
# "Como rodar").

# Postgres
POSTGRES_USER=bodytrack
POSTGRES_PASSWORD=troque-esta-senha-tambem
POSTGRES_DB=bodytrack

# Backend
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=troque-esta-chave-por-uma-chave-secreta-forte
# Domínio(s) do frontend em produção, formato de lista JSON:
CORS_ORIGINS=["https://meudominio.com"]
WEB_CONCURRENCY=2

# Frontend (build-time — vira parte do JS compilado, não é lido em runtime)
# Se a API estiver atrás do mesmo domínio/proxy (recomendado — ver
# seção de deploy do README), use um caminho relativo:
VITE_API_URL=/api/v1
